# Copy to .env and fill in locally. Never commit real values.
# Loaded with: uvicorn app.main:app --env-file .env

# AWS credentials come from this named profile (or the standard AWS_* variables).
# The profile needs bedrock-mantle:CreateInference on the configured models.
AWS_PROFILE=
# Used when aws_region in config.yaml is left as a placeholder.
AWS_REGION=
# Reserved for signing; not used by the prototype yet (docs/ASSUMPTIONS.md A-13).
APP_SECRET_KEY=
# SQLite file. Default: projects/<project>/data/app.db
DATABASE_PATH=
# Which folder under projects/ to load. Default: rental-demo
PROJECT_NAME=
# Password for the single staff login (staff_email in config.yaml). Staff login is off when empty.
STAFF_PASSWORD=
# Set to 1 to run the optional live Bedrock test.
RUN_LIVE_BEDROCK=
